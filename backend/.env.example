# Backend deployment settings. Copy to backend/.env; do not commit backend/.env.
CODE_AUDIT_DEPLOYMENT_MODE=inner
CODE_AUDIT_DB_PROFILE=inner_dws
# Reuse up to this many idle DWS JDBC connections for read-only audit metadata.
CODE_AUDIT_DWS_METADATA_POOL_SIZE=4
# AUDIT_DATABASE_CONFIG=C:\absolute\path\to\database.yaml
AUDIT_DWS_HOST=
AUDIT_DWS_PORT=8000
AUDIT_DWS_DATABASE=
AUDIT_DWS_USER=
AUDIT_DWS_PASSWORD=
AUDIT_DWS_SCHEMA=dwp

# Asset portal is the authoritative source for term roots and audit-result links.
# The audit service requests <ASSET_PORTAL_BASE_URL>/api/roots.
ASSET_PORTAL_BASE_URL=
# Optional bearer token for deployments that protect GET /api/roots.
ASSET_PORTAL_API_TOKEN=
# Optional persistent cache file. It is used only when the portal is unavailable.
# ASSET_PORTAL_ROOT_CACHE_FILE=/var/lib/code-audit/asset-portal-roots.json
ASSET_PORTAL_ROOT_CACHE_TTL_SECONDS=300
ASSET_PORTAL_ROOT_TIMEOUT_SECONDS=10

# Local directory audit is intentionally disabled for inner-network deployment.
AUDIT_LOCAL_SOURCE_ENABLED=false
# Set the exact frontend origin(s), never '*'.
AUDIT_CORS_ORIGINS=https://audit.example.internal
AUDIT_HOST=0.0.0.0
AUDIT_PORT=5088
AUDIT_DEBUG=false

# FineReport report-preview endpoint. Use the actual FineReport host in deployment.
FINE_REPORT_PREVIEW_URL=https://fine.example.com/svn_check.html
