# Backend deployment settings. Copy to backend/.env; do not commit backend/.env.
CODE_AUDIT_DEPLOYMENT_MODE=inner
CODE_AUDIT_DB_PROFILE=inner_dws
# AUDIT_DATABASE_CONFIG=C:\absolute\path\to\database.yaml
AUDIT_DWS_HOST=
AUDIT_DWS_PORT=8000
AUDIT_DWS_DATABASE=
AUDIT_DWS_USER=
AUDIT_DWS_PASSWORD=
AUDIT_DWS_SCHEMA=dwp

# Local directory audit is intentionally disabled for inner-network deployment.
AUDIT_LOCAL_SOURCE_ENABLED=false
# Set the exact frontend origin(s), never '*'.
AUDIT_CORS_ORIGINS=https://audit.example.internal
AUDIT_HOST=0.0.0.0
AUDIT_PORT=5088
AUDIT_DEBUG=false
