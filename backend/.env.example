# Local development backend settings. Copy to backend/.env; do not commit backend/.env.
AUDIT_LOCAL_SOURCE_ENABLED=false
# JSON arrays are recommended on Windows so drive-letter colons are unambiguous.
AUDIT_LOCAL_SOURCE_ROOTS=["E:\\workspace\\audit-samples"]
AUDIT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AUDIT_HOST=127.0.0.1
AUDIT_PORT=5088
AUDIT_DEBUG=false
