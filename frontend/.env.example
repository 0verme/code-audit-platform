# Frontend audit execution mode.
# mock: use local demo data and do not require the backend task API.
# api: submit real audit tasks to the backend API. API failures are shown as errors.
VITE_AUDIT_DATA_MODE=mock

# Backend REST API base URL. Required when VITE_AUDIT_DATA_MODE=api.
# Development:
VITE_API_BASE_URL=http://127.0.0.1:5088/api
# Production behind same-origin reverse proxy:
# VITE_API_BASE_URL=/api

# Optional demo/debug UI controls. Production builds hide Tweaks by default.
# VITE_SHOW_TWEAKS=true

# Enable local directory audit source.
# Usually only for local development or private single-machine deployment.
# Production builds should keep it disabled.
# VITE_ENABLE_LOCAL_SOURCE=false
# This only controls UI presentation. The backend must separately set
# AUDIT_LOCAL_SOURCE_ENABLED=true and AUDIT_LOCAL_SOURCE_ROOTS for local access.
