<?xml version="1.0" encoding="UTF-8"?>
<WorkBook>
  <Report class="com.fr.report.worksheet.WorkSheet" name="Compliant Report">
    <LayerReportAttr clientPaging="true" engineState="1" />
  </Report>
  <Query><![CDATA[
select SOURCE_ID, REPORT_VALUE
from DWF.F_FINE_SOURCE
  ]]></Query>
  <DatabaseName>demo_reporting</DatabaseName>
  <Attributes dsName="表头" columnName="source_id" />
</WorkBook>
